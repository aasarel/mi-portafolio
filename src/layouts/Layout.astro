---
import '../styles/global.css';
import Header from '../components/Header.astro';

const { title = "Asarel - Portafolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&family=IBM+Plex+Mono:ital,wght@0,100..700;1,100..700&family=Inter:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-bg-primary text-text-primary min-h-screen transition-colors duration-200">
    
    <Header />

    <main>
      <slot />
    </main>

  </body>
</html>