---
// Layout.astro — Envoltorio HTML maestro que usan todas las páginas del portafolio.
// Responsabilidades:
//   · Estructura HTML base (<head>, <body>, fuentes, meta tags)
//   · Inyección del Header global en todas las rutas
//   · Dark mode: la clase `.dark` en <html> la gestiona Header.astro via localStorage;
//     este layout no necesita leerla porque Tailwind reacciona a ella en tiempo real.
//   · Google Fonts: Hanken Grotesk (display), IBM Plex Mono (mono), Inter (sans).
//     Se cargan aquí una sola vez para que todos los tokens --font-* de global.css
//     los encuentren disponibles sin importar qué página renderiza primero.

import '../styles/global.css';
import Header from '../components/Header.astro';

const { title = "Asarel - Portafolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- preconnect antes del stylesheet acorta el tiempo de negociación TLS con Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- display=swap evita FOIT: el texto se muestra en fallback mientras carga la fuente -->
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&family=IBM+Plex+Mono:ital,wght@0,100..700;1,100..700&family=Inter:wght@100..900&display=swap" rel="stylesheet" />
  </head>

  <!-- transition-colors evita el flash brusco al cambiar entre temas claro/oscuro -->
  <body class="bg-bg-primary text-text-primary min-h-screen transition-colors duration-200">

    <Header />

    <main>
      <!-- Punto de inyección para todas las páginas hijas -->
      <slot />
    </main>

  </body>
</html>