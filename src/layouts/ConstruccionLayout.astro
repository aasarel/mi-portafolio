---
// ConstruccionLayout.astro — Página de marcador de posición para secciones aún no desarrolladas.
// Muestra un estado visual limpio ("en construcción") con navegación de regreso al portafolio.
//
// Props:
//   section — Nombre de la sección (ej. "Arte Visual"). Aparece en el <title> y en el copy.
//   code    — Código HTTP de estilo developercore que se muestra sobre el título.
//             Por defecto "200 OK"; se puede pasar "202 Accepted" para secciones en proceso.

import Layout from './Layout.astro';

interface Props {
  section?: string;
  code?: string;
}

const { section, code = "200 OK" } = Astro.props;
---

<Layout title={section ? `${section} — Abraham Asarel` : "En construcción — Abraham Asarel"}>
  <main class="min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center px-6 py-20 text-center">

    <div
      aria-hidden="true"
      class="text-[96px] leading-none mb-8 select-none opacity-[0.07] pointer-events-none"
    >
      🦉
    </div>

    <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-text-accent mb-5 block">
      {code}
    </span>

    <h1 class="font-display font-semibold text-[28px] md:text-[36px] leading-tight tracking-tight text-text-primary mb-3">
      Página en construcción
    </h1>

    {section && (
      <p class="font-sans text-[15px] text-text-primary/40 mb-10 max-w-[340px] leading-relaxed">
        {section} está siendo preparado.
      </p>
    )}

    {!section && (
      <p class="font-sans text-[15px] text-text-primary/40 mb-10 max-w-[340px] leading-relaxed">
        Esta sección está siendo preparada.
      </p>
    )}

    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-text-primary/60 hover:text-text-accent transition-colors duration-300 group focus:outline-none focus-visible:ring-2 focus-visible:ring-text-accent/40 rounded px-1 py-1"
      >
        <span class="transform translate-x-0 group-hover:-translate-x-1 transition-transform duration-300">←</span>
        Inicio
      </a>

      <span aria-hidden="true" class="hidden sm:block w-px h-4 bg-text-primary/15"></span>

      <a
        href="/#portafolio"
        class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-text-primary/60 hover:text-text-accent transition-colors duration-300 group focus:outline-none focus-visible:ring-2 focus-visible:ring-text-accent/40 rounded px-1 py-1"
      >
        Ver proyectos
        <span class="transform translate-x-0 group-hover:translate-x-1 transition-transform duration-300">→</span>
      </a>
    </div>

  </main>
</Layout>
