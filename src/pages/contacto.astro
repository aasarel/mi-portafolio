---
// contacto.astro — Página de Contacto
// Secciones:
//   · Hero: título "Hablemos" + subtítulo
//   · Booking card con Cal.com inline embed (30 min)
//   · Divider "O contáctame directamente"
//   · Cards de Email y LinkedIn
//   · Footer: tiempo de respuesta

import Layout from '../layouts/Layout.astro';
import owlLogoRaw from '../assets/logos/owl.svg?raw';
---

<Layout title="Contacto | Asarel Portafolio">

  <div class="relative overflow-x-hidden">

    <!-- ── Búho decorativo de fondo ─────────────────────────────────────── -->
    <div
      class="owl-watermark absolute -right-65 top-[5%] pointer-events-none select-none
             text-text-primary opacity-[0.04] dark:opacity-[0.06]"
      aria-hidden="true"
      set:html={owlLogoRaw}
    />

    <!-- ════════════════════════════════════════════════════════════════════
         GRID MAESTRO — 12 columnas
    ═══════════════════════════════════════════════════════════════════════ -->
    <section
      class="max-w-7xl mx-auto px-4 md:px-8
             pt-12 md:pt-10 pb-24
             grid grid-cols-1 md:grid-cols-12 gap-x-4 gap-y-8
             items-start"
    >

      <!-- ── Título + subtítulo ─────────────────────────────────────────── -->
      <div class="col-span-12 md:col-start-2 md:col-span-10 reveal">
        <h1
          class="font-display text-5xl md:text-[70px] font-bold
                 tracking-[-0.02em] text-text-primary
                 leading-[1.1] md:leading-[120px]"
        >
          Hablemos
        </h1>
        <p class="font-sans text-[16px] font-normal leading-[26px] text-text-secondary max-w-xl mt-2">
          ¿Tienes un proyecto que requiere experiencia UX especializada?
          <br>Agenda una sesión o contáctame directamente.
        </p>
      </div>

      <!-- ── Card de reserva Cal.com ─────────────────────────────────────── -->
      <div class="col-span-12 md:col-start-2 md:col-span-8 reveal reveal-d1">

        <div class="border border-bg-tertiary rounded-2xl overflow-hidden">

          <!-- Header de la card -->
          <div class="px-6 py-5 bg-bg-secondary border-b border-bg-tertiary">
            <div class="flex items-start gap-3">
              <!-- Ícono calendario -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18" height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-accent-forest mt-0.5 shrink-0"
                aria-hidden="true"
              >
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                <line x1="16" x2="16" y1="2" y2="6"/>
                <line x1="8" x2="8" y1="2" y2="6"/>
                <line x1="3" x2="21" y1="10" y2="10"/>
              </svg>
              <div>
                <p class="font-sans font-semibold text-text-primary text-[15px]">
                  Consulta estratégica · 30 min.
                </p>
                <p class="font-sans text-[13px] text-text-secondary mt-0.5">
                  Sesión inicial para conocer tu proyecto, necesidades y cómo puedo ayudarte.
                </p>
              </div>
            </div>
          </div>

          <!-- Cal.com Inline Embed -->
          <div class="bg-bg-primary">
            <div id="cal-inline" class="cal-embed-container"></div>
          </div>

        </div>

      </div>

      <!-- ── Divisor: O CONTÁCTAME DIRECTAMENTE ───────────────────────────── -->
      <div class="col-span-12 md:col-start-2 md:col-span-8 reveal reveal-d2">
        <div class="flex items-center gap-4">
          <div class="flex-1 h-px bg-text-primary/10"></div>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-text-tertiary whitespace-nowrap">
            O contáctame directamente
          </p>
          <div class="flex-1 h-px bg-text-primary/10"></div>
        </div>
      </div>

      <!-- ── Cards de contacto directo ────────────────────────────────────── -->
      <div class="col-span-12 md:col-start-2 md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4 reveal reveal-d3">

        <!-- Email -->
        <a
          href="mailto:abraham_asrel@icloud.com"
          class="group flex items-start gap-4 p-5 rounded-xl
                 border border-bg-tertiary bg-bg-secondary
                 hover:border-accent-forest/40 hover:bg-bg-tertiary
                 transition-all duration-200"
        >
          <div class="mt-0.5 text-text-tertiary group-hover:text-accent-forest transition-colors duration-200 shrink-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18" height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary mb-1.5">Email</p>
            <p class="font-sans text-[14px] font-medium text-text-primary
                      group-hover:text-interaction-link-hover transition-colors duration-200">
              abraham_asrel@icloud.com
            </p>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/abraham-asarel/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 p-5 rounded-xl
                 border border-bg-tertiary bg-bg-secondary
                 hover:border-accent-aurora/40 hover:bg-bg-tertiary
                 transition-all duration-200"
        >
          <div class="mt-0.5 text-text-tertiary group-hover:text-accent-aurora transition-colors duration-200 shrink-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18" height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary mb-1.5">LinkedIn</p>
            <p class="font-sans text-[14px] font-medium text-text-primary
                      group-hover:text-interaction-link-hover transition-colors duration-200">
              in/abraham-asarel
            </p>
          </div>
        </a>

      </div>

      <!-- ── Footer: tiempo de respuesta ───────────────────────────────────── -->
      <div class="col-span-12 md:col-start-2 md:col-span-8 text-center reveal reveal-d4">
        <p class="font-sans text-[13px] text-text-tertiary">
          Tiempo de respuesta habitual:
          <span class="text-text-secondary font-medium">24 horas</span>
        </p>
      </div>

    </section>

  </div>

</Layout>

<!-- ═══════════════════════════════════════════════════════════════════════
     CAL.COM EMBED — Calendario inline
     Reemplaza "TU_USUARIO/30min" con el link real de Cal.com.
     Ejemplo: "aasarel/consulta-estrategica"
     El brandColor usa accent-forest (#5E6B5C) para coherencia visual.
════════════════════════════════════════════════════════════════════════ -->
<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["-", namespace, api]);
        } else {
          p(cal, ar);
        }
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", { origin: "https://cal.com" });

  Cal("inline", {
    elementOrSelector: "#cal-inline",
    calLink: "aasarel/30min",
    layout: "month_view"
  });

  Cal("ui", {
    styles: { branding: { brandColor: "#5E6B5C" } },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>

<style>
  /* Búho de fondo — escala grande para efecto marca de agua */
  .owl-watermark :global(svg) {
    width: 520px;
    height: auto;
    display: block;
  }

  /* Contenedor del embed — altura mínima mientras carga el iframe */
  .cal-embed-container {
    width: 100%;
    min-height: 560px;
    overflow: scroll;
  }

  /* Elimina el borde por defecto del iframe de Cal.com */
  .cal-embed-container :global(iframe) {
    border: none !important;
    width: 100%;
    min-height: 560px;
  }
</style>
