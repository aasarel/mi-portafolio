---
// =========================================================================
// PÁGINA DE DETALLE: MOSES - SCADA
// Framework: Astro v6 + Tailwind CSS v4 nativo
// =========================================================================

// Importación de layout y componentes estructurales
import ProjectLayout from '../layouts/ProjectLayout.astro';
import ImageSlider from '../components/ImageSlider.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import imgAntes from '../assets/projects/moses/slider-antes.png';
import imgDespues from '../assets/projects/moses/slider-despues.jpg';

// 1. METADATOS DEL PROYECTO /Fuente de verdad)
const caseStudySteps = [
  { id: "inicio", label: "Inicio" },
  { id: "contexto", label: "Contexto y Desafío" },
  { id: "investigacion", label: "Auditoría Normativa" },
  { id: "arquitectura", label: "Arquitectura de Información" },
  { id: "bocetos", label: "Bocetos Iniciales" },
  { id: "sistema", label: "Diseño de Componentes" },
  { id: "pruebas", label: "Validación Operativa" },
  { id: "resultados", label: "Impacto de Negocio" },
  { id: "aprendizajes", label: "Lecciones Aprendidas" }
];
---

<ProjectLayout
  title="MOSES - SCADA"
  subtitle="Rediseño visual y funcional del sistema de monitoreo estructural del Tren Interurbano México - Toluca"
  role="UX Product Designer"
  duration="14 meses"
  company="Grupo Sener México"
>
  
  <ImageSlider
    beforeImage={imgAntes.src}
    afterImage={imgDespues.src}
    beforeLabel="SIMATIC WinCC — Interfaz Original (Estilo Win XP)"
    afterLabel="ISA-101 Compliant — Rediseño de Alta Eficiencia"
  />

  <div class="mx-auto max-w-[1552px] px-6 md:px-12 lg:px-[128px] relative mt-24">
    
    <ReadingProgress steps={caseStudySteps} />

    <div class="w-full max-w-[800px] mx-auto pr-0 lg:pr-16 flex flex-col gap-32">
      
      <section id="contexto" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Contexto y Desafío Operativo</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Aquí se vierte el análisis de la migración del sistema montado en WinCC y la problemática de la interfaz heredada tipo Windows XP.
        </p>
      </section>

      <section id="investigacion" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Auditoría Normativa e Investigación</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Justificación metodológica basada en los estándares internacionales de ingeniería industrial ISA-101, ISA-18.2 e ISO 9241-210.
        </p>
      </section>

      <section id="arquitectura" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Arquitectura de Información</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Estructuración y ordenamiento de flujos operativos para reducir la fatiga por alarmas de los operadores del centro de control.
        </p>
      </section>

      <section id="bocetos" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Bocetos Iniciales</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Primeras iteraciones visuales y wireframes estructurados para validar la carga cognitiva de la interfaz.
        </p>
      </section>

      <section id="sistema" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Diseño de Componentes (Asarel UI)</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Construcción de los micro-componentes semánticos, paleta de color atenuada y tipografías optimizadas para visualización SCADA.
        </p>
      </section>

      <section id="pruebas" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Validación Operativa</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Simulaciones de escenarios críticos de riesgo estructural con expertos para medir los tiempos de reacción ante alarmas mayores.
        </p>
      </section>

      <section id="resultados" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Impacto de Negocio</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Métricas de éxito finales del proyecto: reducción del porcentaje de omisión de alertas y optimización del tiempo de respuesta del operador.
        </p>
      </section>

      <section id="aprendizajes" class="min-h-[500px] border-t border-text-primary/5 pt-12 text-left scroll-mt-32">
        <h2 class="font-display font-semibold text-2xl text-text-primary mb-6">Lecciones Aprendidas</h2>
        <p class="font-sans text-[15px] leading-[26px] text-text-primary/70 [text-wrap:pretty]">
          Conclusiones sobre el diseño UX aplicado a entornos de alta seguridad industrial y balance técnico entre costo y beneficio.
        </p>
      </section>

    </div>
  </div>
</ProjectLayout>