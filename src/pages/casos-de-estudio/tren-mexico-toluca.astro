<script>
  // Gate de permisos del botón "Ver el prototipo en Figma": no navega, revela
  // un mensaje de acceso restringido al hacer clic o al recibir foco por teclado.
  function initFigmaGate() {
    document.querySelectorAll<HTMLButtonElement>('[data-figma-gate-trigger]').forEach((btn) => {
      const message = btn.parentElement?.querySelector<HTMLElement>('[data-figma-gate-message]');
      if (!message) return;
      const reveal = () => {
        message.classList.remove('opacity-0', 'max-h-0');
        message.classList.add('opacity-100', 'max-h-20');
      };
      btn.addEventListener('click', reveal);
      btn.addEventListener('focus', reveal);
    });
  }

  document.addEventListener('astro:page-load', initFigmaGate);
  initFigmaGate();
</script>
