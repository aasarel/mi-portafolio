---
// index.astro — Página de inicio del portafolio
// Astro v6 · Tailwind CSS v4 · Design tokens en src/styles/global.css
// Dark mode via clase `.dark` en <html> (gestionado por Layout)

import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import owlLogoRaw from '../assets/logos/owl.svg?raw';
import me from '../assets/logos/me.webp';
---

<Layout title="Home | Asarel Portafolio">

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECCIÓN HERO
       Grid de 12 columnas con offset en md+:
         · Col 2–12 (span 11): Titular H1
         · Col 2–7  (span 6):  Copy editorial + firma
         · Col 8    (span 1):  Divisor vertical con ícono búho
         · Col 9–11 (span 3):  Fotografía de perfil circular
         · Col 1–12 (full):    CTA "Explora mi trabajo"
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 pt-12 md:pt-10 pb-20 md:pb-32 grid grid-cols-1 md:grid-cols-12 gap-4 items-center">

    <!-- ── Titular H1 ──────────────────────────────────────────────────── -->
    <!-- Offset de 1 columna en md+ para alinear con el margen del copy -->
    <div class="col-span-12 md:col-start-2 md:col-span-11 text-left mb-12 md:mb-8 reveal">
      <h1 class="font-display text-5xl md:text-[70px] font-bold tracking-[-0.02em] text-text-primary leading-[1.1] md:leading-[76px]">
        Si la interfaz frustra,<br />el diseño falló.
      </h1>
    </div>

    <!-- ── Copy editorial + firma ──────────────────────────────────────── -->
    <div class="col-span-12 md:col-start-2 md:col-span-6 flex flex-col justify-between h-full space-y-6 reveal reveal-d1">
      <p class="font-sans text-[16px] font-semibold leading-[26px] text-text-primary">
        Diseñar productos digitales no es acumular pantallas ni seguir tendencias. Me atraen los proyectos complejos porque mi trabajo es encontrar una solución ridículamente simple y clara. El diseño de producto es claridad; se trata de entender a fondo a las personas para diseñar flujos simplificados. Si el producto responde al sentido humano, el valor y el impacto en el negocio llegan solos.
      </p>
      <p class="font-sans text-[16px] font-normal leading-[26px] text-text-primary/90">
        Al final, el diseño de productos digitales es, en su forma más pura, un ejercicio de empatía. Transformar esa visión en sistemas intuitivos que se adapten a la naturaleza humana.
      </p>

      <!-- Firma caligráfica + rol — alineada a la derecha con padding relativo al grid -->
      <div class="pt-4 text-right flex flex-col items-end pr-4 md:pr-12">
        <p class="font-signature text-4xl md:text-5xl text-text-link antialiased select-none tracking-wide">
          Abraham Asarel Cruz
        </p>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-text-accent mt-1">
          UX <span class="text-text-accent">|</span> Product Designer
        </p>
      </div>
    </div>

    <!-- ── Divisor visual: línea vertical + ícono búho ────────────────── -->
    <!-- Solo visible en md+. El SVG se inlinea con set:html para que
         fill: currentColor herede --color-accent-forest del wrapper.
         Con <img> esto no sería posible ya que los SVG externos no
         reciben la propiedad CSS `color` de la página. -->
    <div class="hidden md:flex md:col-span-1 flex-col items-center justify-center h-full relative min-h-[280px]">
      <div class="w-[1px] bg-text-primary/20 h-full flex items-center justify-center">
        <div class="bg-bg-primary py-3 z-10">
          <div
            aria-hidden="true"
            class="owl-divider text-accent-forest"
            set:html={owlLogoRaw}
          />
        </div>
      </div>
    </div>

    <!-- ── Fotografía de perfil ────────────────────────────────────────── -->
    <!-- <Image /> genera srcset WebP en 280px y 560px (retina).
         mix-blend-luminosity + grayscale integra la foto con el fondo
         del tema sin depender de un color de fondo específico. -->
    <div id="hero-photo" class="col-span-12 md:col-span-3 flex justify-center md:justify-start reveal reveal-d2">
      <div class="relative w-full max-w-[280px] aspect-[5/5] overflow-hidden bg-bg-secondary rounded-[50%_50%_50%_50%] border border-text-primary/10 shadow-sm">
        <Image
          src={me}
          alt="Abraham Asarel"
          widths={[280, 560]}
          sizes="280px"
          class="w-full h-full object-cover grayscale contrast-[1.15] mix-blend-luminosity"
        />
      </div>
    </div>

    <!-- ── CTA principal ───────────────────────────────────────────────── -->
    <div class="col-span-12 flex justify-center pt-16 md:pt-24 reveal reveal-d3">
      <a href="/proyectos" class="inline-block bg-text-primary text-bg-primary px-8 py-3.5 rounded-full font-sans font-semibold text-sm tracking-wide transition-all duration-200 hover:bg-text-accent hover:text-bg-primary active:scale-[0.98]">
        Explora mi trabajo
      </a>
    </div>

  </section>


</Layout>

<style>
  .owl-divider :global(svg) {
    height: 32px;
    width: auto;
    display: block;
  }
  /* Paralaje: la imagen se desplaza más lento que el scroll para crear profundidad */
  #hero-photo {
    will-change: transform;
  }
</style>

<script>
  // Paralaje sutil en la foto de perfil — solo en dispositivos con puntero fino (desktop)
  // La imagen se desplaza al 14% de la velocidad del scroll (hacia abajo),
  // lo que la hace "quedarse" ligeramente mientras el resto sube, creando profundidad.
  function initParallax(): void {
    const isCoarse = window.matchMedia('(pointer: coarse)').matches;
    if (isCoarse) return;

    const photo = document.getElementById('hero-photo');
    if (!photo) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const offset = window.scrollY * 0.14;
          photo.style.transform = `translateY(${offset}px)`;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  initParallax();
  document.addEventListener('astro:after-swap', initParallax);
</script>
