---
// =========================================================================
// PÁGINA: proyectos.astro — Listado completo de proyectos del portafolio
// =========================================================================
// Ruta: /proyectos
// Layout editorial inspirado en vanschneider.com:
//   · Cabecera de sección con label mono + H1 + descripción (con reveals escalonados)
//   · Contenedor centrado max-w-[1100px] (~70% de viewport en 1440px)
//   · Cada ProjectRow es un caso de estudio con carrusel dominante
//   · Espaciado generoso entre entradas (py-20 md:py-28) para respiración visual
//
// Para agregar un nuevo proyecto:
//   1. Importar sus imágenes (ImageMetadata) o URLs de placeholder
//   2. Añadir un objeto al array `projects` con id, title, platform, description, link e images
//   3. El ProjectRow se genera automáticamente en el map()
// =========================================================================

import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';

import sliderDespues from '../assets/projects/moses/slider-despues.webp';
import sliderDetalle from '../assets/projects/moses/slider-detalle.webp';
import sliderN1 from '../assets/projects/comunicaciones/sliderN1.jpg';

const projects = [
  {
    id: "moses-scada",
    title: "MOSES - SCADA: Rediseño visual y funcional del sistema de monitoreo del tren interurbano México Toluca",
    platform: "Figma | Notion | Ilustrator | SIMATIC WinCC 8.1",
    description: "En sistemas críticos, la saturación visual es un riesgo de seguridad. Convertí un entorno obsoleto en un sistema modular y escalable que mitiga la carga cognitiva y elimina la fatiga por alarmas utilizando normativas internacionales y principios avanzados de UX.",
    link: "/moses-scada",
    images: [sliderDespues, sliderDetalle],
    activeIndex: 0
  },
  {
    id: "repo-moses-scada",
    title: "MOSES - SCADA: Arquitectura lógica y sistema de diseño modular para la red de comunicaciones",
    platform: "Figma | Notion | Ilustrator | SIMATIC WinCC 8.1",
    description: "En el control ferroviario, la claridad visual equivale a tiempo de reacción. Rediseñé el módulo de comunicaciones de MOSES-SCADA, implementando una arquitectura de cuatro niveles jerárquicos que agiliza el aislamiento de fallas y asegura la operación.",
    link: "/repo-moses-scada",
    images: [sliderN1],
    activeIndex: 0
  }
];
---

<Layout title="Proyectos | Asarel Portafolio">

  <!-- ══════════════════════════════════════════════════════════════
       CABECERA DE SECCIÓN — Introduce el espacio editorial
  ══════════════════════════════════════════════════════════════ -->
  <section class="w-full pt-16 md:pt-14 pb-16 md:pb-5 border-b border-text-accent/25">
    <div class="mx-auto max-w-[1100px] px-6 md:px-8">

      <h1 class="font-display text-[16px] md:text-[24px] lg:text-[32x] font-bold uppercase tracking-[0.25em] text-text-accent leading-[1.05] mb-6 reveal reveal-d1">
        Portafolio
      </h1>

      <p class="font-sans text-[16px] md:text-[18px] font-normal leading-[26px] text-text-primary/70 reveal reveal-d pb-0">
        <strong>Aquí no hay diseños para rellenar el ojo.</strong> Es una mirada profunda a cómo tomo proyectos complejos y los convierto en productos digitales intuitivos, escalables y con propósito.
      </p>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       LISTADO DE PROYECTOS
       Cada ProjectRow es un caso de estudio completo.
       El ancho máximo de 1100px centra visualmente la imagen,
       creando la proporción editorial de Van Schneider (~68% viewport).
  ══════════════════════════════════════════════════════════════ -->
  <div class="w-full flex flex-col">
    {projects.map((project) => (
      <ProjectRow
        id={project.id}
        title={project.title}
        description={project.description}
        link={project.link}
        platform={project.platform}
        images={project.images}
        activeIndex={project.activeIndex}
      />
    ))}
  </div>

</Layout>
