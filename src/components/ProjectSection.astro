---
// =========================================================================
// ABRAHAM DESIGN SYSTEM — COMPONENTE GLOBAL: ProjectSection.astro
// =========================================================================

interface Props {
  id: string;      // ID de anclaje para ReadingProgress
  title: string;   // Título de la sección
  eyebrow?: string; // Micro-indexador mono opcional sobre el título (ej: "01 — Resumen del proyecto")
  wide?: boolean;   // true: carril de ~1296px (grids de tarjetas); false (default): carril-lectura de 800px
}

const { id, title, eyebrow, wide = false } = Astro.props;

const wrapperClass = wide
  ? "w-full max-w-[1296px] mx-auto px-4 md:px-0 flex flex-col gap-8"
  : "carril-lectura flex flex-col gap-8";
---

<section
  id={id}
  class="w-full scroll-mt-20 md:my-7 animate-fade-in"
>
  {/* Contenedor único para el título y el contenido (Slot) */}
  <div class={wrapperClass}>

    <div class="flex flex-col gap-2">
      {eyebrow && (
        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-text-accent">
          {eyebrow}
        </span>
      )}
      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-text-primary [text-wrap:balance] text-left">
        {title}
      </h2>
    </div>

    {/* El slot inyecta el contenido (EditorialBody) aquí */}
    <div class="w-full">
      <slot />
    </div>

  </div>
</section>