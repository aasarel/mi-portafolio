---
// =========================================================================
// ABRAHAM DESIGN SYSTEM — COMPONENTE GLOBAL: ProjectSection.astro
// =========================================================================

interface Props {
  id: string;    // ID de anclaje para ReadingProgress
  title: string; // Título de la sección
}

const { id, title } = Astro.props;
---

<section 
  id={id} 
  class="w-full scroll-mt-20 md:my-7 animate-fade-in"
>
  {/* Contenedor único para el título y el contenido (Slot) */}
  <div class="carril-lectura flex flex-col gap-8">
    
    <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight text-text-primary [text-wrap:balance] text-left">
      {title}
    </h2>

    {/* El slot inyecta el contenido (EditorialBody) aquí */}
    <div class="w-full">
      <slot />
    </div>

  </div>
</section>