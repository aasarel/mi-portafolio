---
// ==========================================
// COMPONENTE: ImageSlider.astro (Versión Blindada)
// ==========================================

interface Props {
  beforeImage: string;
  afterImage: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const { 
  beforeImage, 
  afterImage, 
  beforeLabel = "Antes", 
  afterLabel = "Después" 
} = Astro.props;
---

<section class="mx-auto max-w-[1552px] px-6 md:px-12 lg:px-[128px] mt-0 md:mt-8 mb-20">
  
  <div class="relative w-full aspect-[1296/549] bg-bg-primary rounded overflow-hidden border border-text-primary/10 select-none image-slider-master">
    
    <img 
      src={beforeImage} 
      alt="Captura de la interfaz original" 
      class="absolute inset-0 w-full h-full object-contain contrast-110 pointer-events-none z-0"
    />
    <div class="absolute bottom-4 left-4 bg-bg-primary/80 backdrop-blur px-3 py-1 rounded text-[10px] font-mono uppercase tracking-widest text-text-primary z-10 pointer-events-none">
      {beforeLabel}
    </div>

    <div 
      class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden slider-overlay z-10"
      style="clip-path: inset(0 0 0 50%);"
    >
      <img 
        src={afterImage} 
        alt="Captura del rediseño visual optimizado" 
        class="absolute inset-0 w-full h-full object-contain pointer-events-none"
      />
      <div class="absolute bottom-4 right-4 bg-text-primary text-bg-primary px-3 py-1 rounded text-[10px] font-mono uppercase tracking-widest z-10 pointer-events-none">
        {afterLabel}
      </div>
    </div>

    <div 
      class="absolute top-0 bottom-0 w-[1px] bg-text-primary z-20 pointer-events-none slider-divider"
      style="left: 50%;"
    >
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-bg-primary border border-text-primary/20 shadow-2xl flex items-center justify-center text-text-primary text-xs font-mono backdrop-blur-sm transition-transform duration-300 slider-btn">
        ↔
      </div>
    </div>

    <input 
      type="range" 
      min="0" 
      max="100" 
      value="50" 
      class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30 slider-input focus:outline-none"
      aria-label="Deslizador para comparar el diseño antes y después"
    />

  </div>
</section>

<style>
  /* Escala sutil del botón central al hacer hover sobre el área del slider */
  .image-slider-master:hover .slider-btn {
    transform: translateX(-50%) translateY(-50%) scale(1.08);
  }
</style>

<script>
  function initSliders() {
    const containers = document.querySelectorAll('.image-slider-master');
    
    containers.forEach((container) => {
      const input = container.querySelector('.slider-input') as HTMLInputElement;
      const overlay = container.querySelector('.slider-overlay') as HTMLElement;
      const divider = container.querySelector('.slider-divider') as HTMLElement;

      if (!input || !overlay || !divider) return;

      const updateSlider = () => {
        const value = input.value;
        overlay.style.clipPath = `inset(0 0 0 ${value}%)`;
        divider.style.left = `${value}%`;
      };

      input.addEventListener('input', updateSlider);
      updateSlider();
    });
  }

  document.addEventListener('astro:page-load', initSliders);
  initSliders();
</script>