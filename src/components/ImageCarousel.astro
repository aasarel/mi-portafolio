---
// =========================================================================
// ABRAHAM DESIGN SYSTEM — COMPONENTE: ImageCarousel.astro
// =========================================================================
// Propósito: Galería de un caso de estudio en un solo contenedor de imagen,
// con navegación por carrusel. Mismo viewport y motor que el carrusel de
// ProjectRow.astro (usado en /proyectos): watermark, autoplay con pausa en
// hover/clic, flechas, indicadores e interacciones — sin los metadatos de
// proyecto (título/descripción/link) que ProjectRow añade alrededor.
//
// Ancho: w-full — hereda el carril de la sección contenedora (ProjectSection
// wide = max-w-[1296px]), sin trucos de full-bleed.
// =========================================================================

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  ariaLabel?: string;
}

const { images, ariaLabel = "Galería de imágenes" } = Astro.props;
---

<div class="image-carousel w-full flex flex-col gap-4" data-image-carousel>

  <div
    class="relative w-full aspect-[1296/549] bg-bg-primary rounded overflow-hidden group carousel-viewport focus:outline-none transition-all duration-300 data-[keyboard-focus=true]:ring-2 data-[keyboard-focus=true]:ring-text-primary/40 data-[keyboard-focus=true]:ring-offset-4 data-[keyboard-focus=true]:ring-offset-bg-primary"
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label={ariaLabel}
    data-keyboard-focus="false"
  >
    <!-- Watermark decorativo — apenas visible (3% opacidad) -->
    <div class="absolute inset-0 flex items-center justify-center text-text-primary/[0.03] pointer-events-none select-none z-0">
      <span class="text-[180px] md:text-[240px] font-mono"></span>
    </div>

    <div class="absolute inset-0 z-10 w-full h-full pointer-events-none">
      {images.map((img, index) => (
        <Image
          src={img.src}
          alt={img.alt}
          widths={[400, 800, 1200, 1600]}
          sizes="(max-width: 768px) calc(100vw - 48px), 1296px"
          class={`absolute inset-0 w-full h-full object-contain object-left transition-all duration-[1000ms] ease-out-apple ${index === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-[0.98]'}`}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          data-index={index}
        />
      ))}
    </div>

    <button class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-bg-primary/20 to-transparent z-20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer nav-arrow-left" aria-label="Imagen anterior" tabindex="-1">
      <span class="text-2xl font-mono text-text-primary select-none pointer-events-none">←</span>
    </button>
    <button class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-bg-primary/20 to-transparent z-20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer nav-arrow-right" aria-label="Siguiente imagen" tabindex="-1">
      <span class="text-2xl font-mono text-text-primary select-none pointer-events-none">→</span>
    </button>

    <!-- Etiqueta "Pausado" — visible solo cuando isPaused=true en JS -->
    <div class="absolute top-4 left-4 z-20 bg-bg-primary/80 backdrop-blur px-3 py-1 rounded text-[10px] font-mono uppercase tracking-widest opacity-0 transition-opacity duration-300 pause-indicator select-none pointer-events-none">
      Pausado
    </div>
  </div>

  <div class="flex gap-2 w-full indicators-wrapper">
    {images.map((_, index) => (
      <button class="py-3 flex- cursor-pointer focus:outline-none" data-to-index={index} aria-label={`Ir a la imagen ${index + 1}`} aria-current={index === 0 ? "true" : "false"}>
        <div class={`h-0.5 w-7 rounded transition-all duration-300 ${index === 0 ? 'bg-text-primary' : 'bg-text-primary/20'}`}></div>
      </button>
    ))}
  </div>
</div>

<style>
  .ease-out-apple { transition-timing-function: cubic-bezier(0.15, 1, 0.3, 1); }
</style>

<script>
  function initImageCarousels() {
    document.querySelectorAll<HTMLElement>('[data-image-carousel]').forEach((root) => {
      const images = root.querySelectorAll('.carousel-viewport img');
      const indicatorsButtons = root.querySelectorAll('.indicators-wrapper button');
      const viewport = root.querySelector('.carousel-viewport') as HTMLElement;
      const arrowLeft = root.querySelector('.nav-arrow-left');
      const arrowRight = root.querySelector('.nav-arrow-right');
      const pauseIndicator = root.querySelector('.pause-indicator');

      let currentIndex = 0;
      const total = images.length;
      if (total <= 1) return;

      let intervalId: ReturnType<typeof setInterval> | null = null;
      let isPaused = false;
      const autoplayTime = 4000;

      function goToIndex(nextIndex: number) {
        if (nextIndex < 0) nextIndex = total - 1;
        if (nextIndex >= total) nextIndex = 0;
        currentIndex = nextIndex;

        images.forEach((img, idx) => {
          if (idx === currentIndex) {
            img.classList.remove('opacity-0', 'scale-[0.98]');
            img.classList.add('opacity-100', 'scale-100');
          } else {
            img.classList.remove('opacity-100', 'scale-100');
            img.classList.add('opacity-0', 'scale-[0.98]');
          }
        });

        indicatorsButtons.forEach((btn, idx) => {
          btn.setAttribute('aria-current', idx === currentIndex ? 'true' : 'false');
          const bar = btn.querySelector('div');
          if (idx === currentIndex) {
            bar?.classList.remove('bg-text-primary/20');
            bar?.classList.add('bg-text-primary');
          } else {
            bar?.classList.remove('bg-text-primary');
            bar?.classList.add('bg-text-primary/20');
          }
        });
      }

      function startAutoplay() { if (!isPaused) { intervalId = setInterval(() => goToIndex(currentIndex + 1), autoplayTime); } }
      function stopAutoplay() { if (intervalId) clearInterval(intervalId); }

      function togglePause() {
        isPaused = !isPaused;
        if (isPaused) {
          stopAutoplay();
          pauseIndicator?.classList.remove('opacity-0');
          pauseIndicator?.classList.add('opacity-100');
        } else {
          pauseIndicator?.classList.remove('opacity-100');
          pauseIndicator?.classList.add('opacity-0');
          startAutoplay();
        }
      }

      arrowLeft?.addEventListener('click', (e) => { e.stopPropagation(); goToIndex(currentIndex - 1); });
      arrowRight?.addEventListener('click', (e) => { e.stopPropagation(); goToIndex(currentIndex + 1); });

      viewport?.addEventListener('mouseenter', () => { if (!isPaused) stopAutoplay(); });
      viewport?.addEventListener('mouseleave', () => { if (!isPaused) startAutoplay(); });

      indicatorsButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetIndex = parseInt(btn.getAttribute('data-to-index') ?? '0');
          goToIndex(targetIndex);
        });
      });

      let isTabNavigation = false;
      window.addEventListener('keydown', (e) => { if (e.key === 'Tab') isTabNavigation = true; }, { passive: true });
      window.addEventListener('mousedown', () => { isTabNavigation = false; }, { passive: true });

      viewport?.addEventListener('focus', () => {
        if (isTabNavigation) viewport.setAttribute('data-keyboard-focus', 'true');
      });
      viewport?.addEventListener('blur', () => {
        viewport.setAttribute('data-keyboard-focus', 'false');
      });

      window.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;

        const hasFocus = root.contains(document.activeElement);
        const rect = root.getBoundingClientRect();
        const viewportCenter = window.innerHeight / 2;
        const isCentered = rect.top < viewportCenter && rect.bottom > viewportCenter;
        const noForeignFocus = !document.activeElement || document.activeElement === document.body || root.contains(document.activeElement);

        if (hasFocus || (isCentered && noForeignFocus)) {
          e.preventDefault();
          if (e.key === 'ArrowLeft') goToIndex(currentIndex - 1);
          if (e.key === 'ArrowRight') goToIndex(currentIndex + 1);
        }
      });

      let wheelTimeout: ReturnType<typeof setTimeout> | null = null;
      viewport?.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaX) > 30) {
          e.preventDefault();
          if (!wheelTimeout) {
            if (e.deltaX > 0) goToIndex(currentIndex + 1);
            if (e.deltaX < 0) goToIndex(currentIndex - 1);
            wheelTimeout = setTimeout(() => { wheelTimeout = null; }, 600);
          }
        }
      }, { passive: false });

      viewport?.addEventListener('click', () => { togglePause(); });

      let touchStartX = 0;
      let touchEndX = 0;
      viewport?.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
      viewport?.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const threshold = 50;
        if (touchStartX - touchEndX > threshold) goToIndex(currentIndex + 1);
        if (touchEndX - touchStartX > threshold) goToIndex(currentIndex - 1);
      }, { passive: true });

      startAutoplay();
    });
  }

  document.addEventListener('astro:page-load', initImageCarousels);
  initImageCarousels();
</script>
