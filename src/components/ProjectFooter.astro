---
// ProjectFooter.astro — Pie de página para las páginas de caso de estudio.
// Dos bloques:
//   1. CTA central — invita al visitante a contactar; su texto y href son configurables
//      para que cada caso pueda tener un llamado a la acción personalizado.
//   2. Navegación entre proyectos — filas prevProject / nextProject opcionales.
//      Si un lado no se pasa, ese lado renderiza un <div /> vacío para mantener
//      el layout flex justify-between equilibrado.

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  heading?: string;
  ctaLabel?: string;
  ctaHref?: string;
  prevProject?: NavItem;
  nextProject?: NavItem;
}

const {
  heading = "¿Tienes un proyecto similar?",
  ctaLabel = "Hablemos de tu Proyecto",
  ctaHref = "/#contacto",
  prevProject,
  nextProject,
} = Astro.props;
---

<footer class="w-full mt-24 border-t border-text-primary/10">
  <div class="mx-auto max-w-[1920px] px-6 md:px-12 lg:px-[128px]">

    {/* CTA central */}
    <div class="flex flex-col items-center gap-6 py-16 md:py-20">
      <h2 class="font-display font-semibold text-[22px] md:text-[26px] leading-tight tracking-tight text-text-primary text-center">
        {heading}
      </h2>
      <a
        href={ctaHref}
        class="inline-flex items-center px-8 py-4 rounded-full bg-text-primary text-bg-primary font-sans font-medium text-[15px] tracking-tight hover:opacity-80 transition-opacity duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-text-accent/50"
      >
        {ctaLabel}
      </a>
    </div>

    {/* Navegación entre proyectos */}
    {(prevProject || nextProject) && (
      <div class="flex items-stretch justify-between border-t border-text-primary/10 py-10">

        {prevProject ? (
          <a
            href={prevProject.href}
            class="group flex flex-col gap-1.5 border-l-2 border-text-primary/15 pl-4 hover:border-text-accent transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-text-accent/40 rounded-sm"
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-primary/40 group-hover:text-text-accent transition-colors duration-300 flex items-center gap-1.5">
              <span class="transform translate-x-0 group-hover:-translate-x-1 transition-transform duration-300">←</span>
              Proyecto anterior
            </span>
            <span class="font-display font-medium text-[15px] leading-snug text-text-primary/70 group-hover:text-text-primary transition-colors duration-300">
              {prevProject.label}
            </span>
          </a>
        ) : <div />}

        {nextProject ? (
          <a
            href={nextProject.href}
            class="group flex flex-col gap-1.5 border-r-2 border-text-primary/15 pr-4 text-right hover:border-text-accent transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-text-accent/40 rounded-sm"
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-primary/40 group-hover:text-text-accent transition-colors duration-300 flex items-center justify-end gap-1.5">
              Proyecto siguiente
              <span class="transform translate-x-0 group-hover:translate-x-1 transition-transform duration-300">→</span>
            </span>
            <span class="font-display font-medium text-[15px] leading-snug text-text-primary/70 group-hover:text-text-primary transition-colors duration-300">
              {nextProject.label}
            </span>
          </a>
        ) : <div />}

      </div>
    )}

  </div>
</footer>
