---
// ContactCard.astro — Card flotante de contacto contextual
// Trigger: window.openContactCard()
// Contenido: Cal.com embed (lazy) + email + LinkedIn
// Cerrar: botón X, clic en overlay, tecla Escape
---

<div
  id="contact-card-overlay"
  aria-hidden="true"
  class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-sm"
>
  <div
    id="contact-card-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Contacto"
    class="w-full max-w-[640px] max-h-[90vh] overflow-y-auto
           bg-bg-primary border border-bg-tertiary rounded-2xl
           shadow-[0_24px_80px_rgba(0,0,0,0.4)]"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-bg-tertiary sticky top-0 bg-bg-primary z-10">
      <h2 class="font-display text-[22px] font-bold text-text-primary">Hablemos</h2>
      <button
        id="contact-card-close"
        aria-label="Cerrar"
        class="text-text-tertiary hover:text-text-primary transition-colors duration-200 p-1.5 rounded-lg
               focus:outline-none focus-visible:ring-2 focus-visible:ring-text-accent/40"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="px-6 py-6 flex flex-col gap-6">

      <!-- Cal.com embed -->
      <div>
        <div class="flex items-start gap-3 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-forest mt-0.5 shrink-0" aria-hidden="true">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
            <line x1="16" x2="16" y1="2" y2="6"/>
            <line x1="8" x2="8" y1="2" y2="6"/>
            <line x1="3" x2="21" y1="10" y2="10"/>
          </svg>
          <div>
            <p class="font-sans font-semibold text-text-primary text-[15px]">Agenda una sesión · 30 min.</p>
            <p class="font-sans text-[13px] text-text-secondary mt-0.5">Sesión inicial para conocer tu proyecto y cómo puedo ayudarte.</p>
          </div>
        </div>
        <div id="cal-inline-card" class="rounded-xl overflow-hidden border border-bg-tertiary bg-bg-primary cal-card-container"></div>
      </div>

      <!-- Divider -->
      <div class="flex items-center gap-4">
        <div class="flex-1 h-px bg-text-primary/10"></div>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary whitespace-nowrap">O contáctame directamente</p>
        <div class="flex-1 h-px bg-text-primary/10"></div>
      </div>

      <!-- Contacto directo -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-2">
        <a
          href="mailto:abraham_asarel@icloud.com"
          class="group flex items-start gap-4 p-4 rounded-xl
                 border border-bg-tertiary bg-bg-secondary
                 hover:border-accent-forest/40 hover:bg-bg-tertiary
                 transition-all duration-200"
        >
          <div class="mt-0.5 text-text-tertiary group-hover:text-accent-forest transition-colors duration-200 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary mb-1">Email</p>
            <p class="font-sans text-[13px] font-medium text-text-primary group-hover:text-interaction-link-hover transition-colors duration-200">
              abraham_asarel@icloud.com
            </p>
          </div>
        </a>

        <a
          href="https://www.linkedin.com/in/abraham-asarel/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 p-4 rounded-xl
                 border border-bg-tertiary bg-bg-secondary
                 hover:border-accent-aurora/40 hover:bg-bg-tertiary
                 transition-all duration-200"
        >
          <div class="mt-0.5 text-text-tertiary group-hover:text-accent-aurora transition-colors duration-200 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary mb-1">LinkedIn</p>
            <p class="font-sans text-[13px] font-medium text-text-primary group-hover:text-interaction-link-hover transition-colors duration-200">
              in/abraham-asarel
            </p>
          </div>
        </a>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var overlay = document.getElementById('contact-card-overlay');
    var calLoaded = false;

    function openContactCard() {
      overlay.setAttribute('data-open', '');
      overlay.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
      if (!calLoaded) { initCal(); calLoaded = true; }
    }

    function closeContactCard() {
      overlay.removeAttribute('data-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function initCal() {
      (function (C, A, L) {
        var p = function (a, ar) { a.q.push(ar); };
        var d = C.document;
        C.Cal = C.Cal || function () {
          var cal = C.Cal; var ar = arguments;
          if (!cal.loaded) {
            cal.ns = {}; cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            var api = function () { p(api, arguments); };
            var ns = ar[1]; api.q = api.q || [];
            if (typeof ns === 'string') {
              cal.ns[ns] = cal.ns[ns] || api;
              p(cal.ns[ns], ar); p(cal, ['-', ns, api]);
            } else { p(cal, ar); }
            return;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      Cal('init', 'card', { origin: 'https://cal.com' });
      Cal.ns.card('inline', {
        elementOrSelector: '#cal-inline-card',
        calLink: 'aasarel/30min',
        layout: 'month_view'
      });
      Cal.ns.card('ui', {
        styles: { branding: { brandColor: '#5E6B5C' } },
        hideEventTypeDetails: false,
        layout: 'month_view'
      });
    }

    document.getElementById('contact-card-close').addEventListener('click', closeContactCard);

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeContactCard();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.hasAttribute('data-open')) closeContactCard();
    });

    window.openContactCard = openContactCard;
  })();
</script>

<style>
  #contact-card-overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  #contact-card-overlay[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  #contact-card-panel {
    transform: translateY(1.25rem);
    transition: transform 0.25s ease;
    /* Scrollbar moderno: fino y translúcido, invisible cuando no hay scroll activo */
    scrollbar-width: thin;
    scrollbar-color: rgba(120, 120, 120, 0.25) transparent;
    scrollbar-gutter: stable;
  }
  #contact-card-overlay[data-open] #contact-card-panel {
    transform: translateY(0);
  }
  /* Chrome / Safari / Edge */
  #contact-card-panel::-webkit-scrollbar {
    width: 4px;
  }
  #contact-card-panel::-webkit-scrollbar-track {
    background: transparent;
  }
  #contact-card-panel::-webkit-scrollbar-thumb {
    background: rgba(120, 120, 120, 0.22);
    border-radius: 9999px;
  }
  #contact-card-panel::-webkit-scrollbar-thumb:hover {
    background: rgba(120, 120, 120, 0.45);
  }
  .cal-card-container {
    width: 100%;
    min-height: 460px;
  }
  .cal-card-container :global(iframe) {
    border: none !important;
    width: 100%;
    min-height: 460px;
  }
</style>
