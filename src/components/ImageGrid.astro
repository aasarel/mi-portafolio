---
// =========================================================================
// ABRAHAM DESIGN SYSTEM — COMPONENTE MAESTRO: ImageGrid.astro
// =========================================================================

interface ImageItem {
  src: string;
  alt: string;
}

interface Props {
  images: ImageItem[];
}

const { images } = Astro.props;
const total = images.length;

const isCinematic = total === 6 || total === 8;

let wrapperClasses = "mx-auto max-w-[1920px] px-6 md:px-12 lg:px-[128px] my-16";
let gridClasses = "";

if (total === 2) {
  gridClasses = "grid-cols-1 md:grid-cols-2 gap-6 md:gap-8";
} else if (total === 4) {
  gridClasses = "grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 max-w-[1200px] mx-auto";
} else if (total === 6) {
  wrapperClasses = "w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] px-6 md:px-12 lg:px-[128px] my-24";
  gridClasses = "grid-cols-2 md:grid-cols-3 gap-4 md:gap-6";
} else if (total === 8) {
  wrapperClasses = "w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] px-6 md:px-12 lg:px-[128px] my-24";
  gridClasses = "grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6";
}
---

<div class={wrapperClasses}>
  
  {/* Agregamos el ID de la galería para que PhotoSwipe lo reconozca */}
  <div class={`grid ${gridClasses} w-full`} id="project-gallery">
    {images.map((img) => (
      
      /* CÁPSULA COHESIVA DE IMAGEN (Ahora es una etiqueta <a> interactiva) */
      <a 
        href={img.src} 
        data-pswp-width="1920" 
        data-pswp-height="1080"
        target="_blank"
        class="relative w-full aspect-video rounded-xl overflow-hidden bg-bg-secondary border border-text-primary/5 shadow-md group/grid-card block cursor-zoom-in pswp-gallery-item"
      >
        <img 
          src={img.src} 
          alt={img.alt} 
          class="w-full h-full object-cover transition-transform duration-700 ease-out-silk group-hover/grid-card:scale-105" 
          loading="lazy"
        />
        <div class="absolute inset-0 bg-black/[0.03] dark:bg-black/[0.15] pointer-events-none transition-colors duration-300 group-hover/grid-card:bg-transparent"></div>
      </a>

    ))}
  </div>

</div>

<style>
  .ease-out-silk {
    transition-timing-function: cubic-bezier(0.3, 0, 0.15, 1.12);
  }
</style>

<script>
  // Importamos PhotoSwipe y sus estilos CSS base
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // 1. Script para autodetectar las medidas reales de las imágenes sin tener que declararlas
  const updateImageDimensions = () => {
    const items = document.querySelectorAll('.pswp-gallery-item');
    items.forEach(item => {
      const img = item.querySelector('img');
      if (img) {
        const setDimensions = () => {
          if(img.naturalWidth && img.naturalHeight) {
             item.setAttribute('data-pswp-width', img.naturalWidth.toString());
             item.setAttribute('data-pswp-height', img.naturalHeight.toString());
          }
        };
        // Si ya cargó la imagen, setea las medidas. Si no, espera a que cargue.
        if (img.complete) {
          setDimensions();
        } else {
          img.addEventListener('load', setDimensions);
        }
      }
    });
  };

  // 2. Inicializamos PhotoSwipe
  const initLightbox = () => {
    updateImageDimensions();
    
    const lightbox = new PhotoSwipeLightbox({
      gallery: '#project-gallery',
      children: 'a',
      pswpModule: () => import('photoswipe'),
      // Configuración estética (fondos oscuros elegantes)
      bgOpacity: 0.9,
      errorMsg: 'La imagen no pudo ser cargada',
    });

    lightbox.init();
  };

  // Ejecutamos en la carga de la página
  document.addEventListener('DOMContentLoaded', initLightbox);
  // Soporte para las transiciones de vista de Astro (View Transitions)
  document.addEventListener('astro:page-load', initLightbox);
</script>